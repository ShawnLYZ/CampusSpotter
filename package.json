{
  "name": "campusspotter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "data:timetable": "node scripts/build-timetable-rows.ts",
    "data:prayer": "node scripts/capture-prayer.ts",
    "data:weather": "node scripts/capture-weather.ts",
    "data:ridership": "node scripts/capture-ridership.ts",
    "data:traffic": "node --env-file=.env scripts/capture-traffic.ts 2026-11-18",
    "check:secrets": "vite build && node --env-file-if-exists=.env scripts/check-bundle-secrets.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@vis.gl/react-google-maps": "^1.10.2",
    "react": "19.3",
    "react-dom": "19.3",
    "react-router": "^7.18.5",
    "recharts": "^3.10.1",
    "three": "^0.187.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^5.2.0",
    "hyparquet": "^1.32.0",
    "hyparquet-compressors": "^1.1.3",
    "tailwindcss": "^4.3.4",
    "typescript": "~5.9",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
